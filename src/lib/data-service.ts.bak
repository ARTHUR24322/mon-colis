const PACKAGES_KEY = 'moncolis_database_packages_v3';
const AGENCIES_KEY = 'moncolis_database_agencies_v3';

class DataService {
  private memoryPackages: ColisItem[] = [];
  private memoryAgencies: AgencyInfo[] = [];

  constructor() {
    this.initStore();
  }

  private initStore() {
    if (typeof window !== 'undefined') {
      try {
        const storedPkgs = localStorage.getItem(PACKAGES_KEY);
        if (storedPkgs) {
          this.memoryPackages = JSON.parse(storedPkgs);
        } else {
          this.memoryPackages = [...INITIAL_PACKAGES];
          this.persistPackages();
        }

        const storedAgencies = localStorage.getItem(AGENCIES_KEY);
        if (storedAgencies) {
          this.memoryAgencies = JSON.parse(storedAgencies);
        } else {
          this.memoryAgencies = [...DEFAULT_AGENCIES];
          this.persistAgencies();
        }
        return;
      } catch (e) {
        console.warn('LocalStorage unavailable, using in-memory data');
      }
    }
    this.memoryPackages = [...INITIAL_PACKAGES];
    this.memoryAgencies = [...DEFAULT_AGENCIES];
  }

  private persistPackages() {
    if (typeof window !== 'undefined') {
      try {
        localStorage.setItem(PACKAGES_KEY, JSON.stringify(this.memoryPackages));
      } catch (e) {}
    }
  }

  private persistAgencies() {
    if (typeof window !== 'undefined') {
      try {
        localStorage.setItem(AGENCIES_KEY, JSON.stringify(this.memoryAgencies));
      } catch (e) {}
    }
  }

  // ── 1. Packages List ─────────────────────────────────────────
  async getAllPackages(): Promise<ColisItem[]> {
    if (this.memoryPackages.length === 0) {
      this.memoryPackages = [...INITIAL_PACKAGES];
      this.persistPackages();
    }
    return [...this.memoryPackages];
  }

  // ── 2. Get Single Package by ID / Tracking / OTP ─────────────
  async getPackageByTracking(query: string): Promise<ColisItem | null> {
    const cleanQuery = query.trim().toLowerCase();
    if (!cleanQuery) return null;

    const all = await this.getAllPackages();
    const found = all.find(
      p =>
        p.id.toLowerCase() === cleanQuery ||
        p.trackingCode.toLowerCase() === cleanQuery ||
        p.otp === cleanQuery
    );
    return found || null;
  }

  // ── 3. Create New Package (Vendeur) ──────────────────────────
  async createPackage(colis: {
    clientName: string;
    clientPhone: string;
    clientAddress: string;
    prixColis: number;
    poids: number;
    longueur: number;
    largeur: number;
    hauteur: number;
    distance: number;
    agence?: string | null;
    prixLivraison?: number | null;
  }): Promise<ColisItem> {
    const idNum = this.memoryPackages.length + 1;
    const newId = `c${idNum}`;
    const trackingCode = `MC-${Math.floor(100000 + Math.random() * 900000)}`;
    const otp = Math.floor(100000 + Math.random() * 900000).toString();
    const today = new Date().toLocaleDateString('fr-FR');

    const newPackage: ColisItem = {
      id: newId,
      trackingCode,
      clientName: colis.clientName,
      clientPhone: colis.clientPhone,
      clientAddress: colis.clientAddress,
      prixColis: colis.prixColis,
      prixLivraison: colis.prixLivraison || (colis.agence ? 1.5 : null),
      poids: colis.poids,
      longueur: colis.longueur,
      largeur: colis.largeur,
      hauteur: colis.hauteur,
      distance: colis.distance,
      status: colis.agence ? 'En attente d\'agence' : 'Créé',
      agence: colis.agence || null,
      livreur: null,
      livreurPhone: null,
      otp,
      date: today,
      confirmed: false,
    };

    this.memoryPackages.unshift(newPackage);
    this.persistPackages();
    return newPackage;
  }

  // ── 4. Agencies & Driver Management ──────────────────────────
  async getAllAgencies(): Promise<AgencyInfo[]> {
    if (this.memoryAgencies.length === 0) {
      this.memoryAgencies = [...DEFAULT_AGENCIES];
      this.persistAgencies();
    }
    return [...this.memoryAgencies];
  }

  async addDriverToAgency(
    agencyId: string,
    driverData: { name: string; phone: string; vehicle?: string; pinCode?: string }
  ): Promise<DriverAccount | null> {
    const agency = this.memoryAgencies.find(a => a.id === agencyId) || this.memoryAgencies[0];
    if (!agency) return null;

    const pinCode = driverData.pinCode || Math.floor(1000 + Math.random() * 9000).toString();
    const newDriver: DriverAccount = {
      id: `drv-${Date.now()}`,
      name: driverData.name,
      phone: driverData.phone,
      pinCode,
      agencyId: agency.id,
      agencyName: agency.name,
      vehicle: driverData.vehicle || 'Moto',
      available: true,
      deliveries: 0,
      rating: 5.0,
      joinedDate: new Date().toISOString().split('T')[0]
    };

    agency.drivers.unshift(newDriver);
    this.persistAgencies();
    return newDriver;
  }

  // ── 5. Driver Authentication (Numero + Code PIN) ─────────────
  async authenticateDriver(phone: string, pinCode: string): Promise<DriverAccount | null> {
    const cleanPhone = phone.trim().replace(/\s+/g, '');
    const cleanPin = pinCode.trim();

    for (const agency of this.memoryAgencies) {
      for (const driver of agency.drivers) {
        const dPhone = driver.phone.replace(/\s+/g, '');
        if (
          (dPhone === cleanPhone || dPhone.endsWith(cleanPhone) || cleanPhone.endsWith(dPhone)) &&
          driver.pinCode === cleanPin
        ) {
          return { ...driver };
        }
      }
    }
    return null;
  }

  // ── 6. Get Packages Assigned to Driver ───────────────────────
  async getPackagesForDriver(driverIdOrPhone: string): Promise<ColisItem[]> {
    const all = await this.getAllPackages();
    const cleanKey = driverIdOrPhone.trim().replace(/\s+/g, '');
    return all.filter(p => {
      if (p.driverId && p.driverId === cleanKey) return true;
      if (p.livreurPhone && p.livreurPhone.replace(/\s+/g, '') === cleanKey) return true;
      if (p.livreur && p.livreur.toLowerCase() === driverIdOrPhone.toLowerCase()) return true;
      return false;
    });
  }

  // ── 7. Agency Assigns Driver to Package ──────────────────────
  async assignDriverToPackage(
    packageId: string,
    driver: { id: string; name: string; phone: string; agencyName?: string }
  ): Promise<ColisItem | null> {
    const pkg = this.memoryPackages.find(p => p.id === packageId);
    if (!pkg) return null;

    pkg.driverId = driver.id;
    pkg.livreur = driver.name;
    pkg.livreurPhone = driver.phone;
    if (driver.agencyName) pkg.agence = driver.agencyName;
    pkg.status = 'En transit';
    this.persistPackages();
    return { ...pkg };
  }

  // ── 8. Vendeur Assigns Agency ────────────────────────────────
  async assignAgency(packageId: string, agencyName: string, prixLivraison: number = 1.5): Promise<ColisItem | null> {
    const pkg = this.memoryPackages.find(p => p.id === packageId);
    if (!pkg) return null;

    const ag = this.memoryAgencies.find(a => a.name === agencyName);
    pkg.agence = agencyName;
    pkg.agencyId = ag ? ag.id : null;
    pkg.prixLivraison = prixLivraison;
    pkg.status = 'En attente d\'agence';
    this.persistPackages();
    return { ...pkg };
  }

  // ── 9. Validate Delivery OTP (Livreur / Client) ──────────────
  async validateDeliveryOtp(packageIdOrCode: string, enteredOtp: string): Promise<{ success: boolean; message: string; package?: ColisItem }> {
    const cleanOtp = enteredOtp.trim();
    if (cleanOtp.length < 6) {
      return { success: false, message: 'Le code de sécurité OTP doit comporter 6 chiffres.' };
    }

    const pkg = this.memoryPackages.find(
      p => p.id === packageIdOrCode || p.trackingCode === packageIdOrCode || p.otp === cleanOtp
    );

    if (!pkg) {
      return { success: false, message: 'Colis introuvable.' };
    }

    if (pkg.status === 'Livré') {
      return { success: true, message: 'Ce colis a déjà été validé et livré avec succès.', package: pkg };
    }

    if (pkg.otp !== cleanOtp) {
      return { success: false, message: 'Code OTP incorrect. Veuillez demander le bon code au client.' };
    }

    // Code valide !
    pkg.status = 'Livré';
    pkg.confirmed = true;
    pkg.deliveredAt = new Date().toISOString();
    this.persistPackages();

    return {
      success: true,
      message: 'Code OTP validé avec succès ! La livraison est confirmée.',
      package: { ...pkg }
    };
  }

  // ── 10. Cancel Package ───────────────────────────────────────
  async cancelPackage(packageId: string): Promise<ColisItem | null> {
    const pkg = this.memoryPackages.find(p => p.id === packageId);
    if (!pkg) return null;

    pkg.status = 'Annulé';
    this.persistPackages();
    return { ...pkg };
  }
}

// Instance Singleton partagée
export const dataService = new DataService();
