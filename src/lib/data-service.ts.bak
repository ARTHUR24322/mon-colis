/**
 * Moncolis Data & Database Service
 * Connecte les composants à Supabase PostgreSQL avec synchronisation temps réel
 * et gestion centralisée des Agences, Vendeurs, Livreurs et Colis.
 */

import { supabase } from '@/utils/supabase/client';

export interface ColisItem {
  id: string;
  trackingCode: string;
  clientName: string;
  clientPhone: string;
  clientAddress: string;
  prixColis: number;
  prixLivraison: number | null;
  poids: number;
  longueur: number;
  largeur: number;
  hauteur: number;
  distance: number;
  status: 'Créé' | 'En attente d\'agence' | 'En transit' | 'Livré' | 'Annulé';
  agence: string | null;
  agencyId?: string | null;
  livreur: string | null;
  livreurPhone: string | null;
  driverId?: string | null;
  otp: string;
  date: string;
  confirmed: boolean;
  deliveredAt?: string | null;
}

export interface DriverAccount {
  id: string;
  name: string;
  phone: string;
  pinCode: string; // Code d'accès à 4-6 chiffres pour se connecter à l'espace livreur
  agencyId: string;
  agencyName: string;
  vehicle: string;
  available: boolean;
  deliveries: number;
  rating: number;
  joinedDate: string;
}

export interface AgencyInfo {
  id: string;
  name: string;
  phone: string;
  address: string;
  score: number;
  recommended: boolean;
  price: string;
  drivers: DriverAccount[];
}

