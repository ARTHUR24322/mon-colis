generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

enum Role {
  vendeur
  agence
  livreur
  admin
}

enum AgencyStatus {
  PENDING
  APPROVED
  REJECTED
  SUSPENDED
}

enum PackageStatus {
  CREATED
  PENDING_AGENCY
  ACCEPTED_BY_AGENCY
  REJECTED_BY_AGENCY
  ASSIGNED_TO_DRIVER
  IN_TRANSIT
  DEPOSITED_AT_DROP_POINT
  PENDING_DROP_POINT_CONFIRMATION
  WAITING_FOR_AGENCY_PICKUP
  AVAILABLE_AT_PICKUP_POINT
  DELIVERED
  CANCELLED
}

// 1. Table Profiles (Utilisateurs: Vendeurs, Agences, Livreurs, Admins)
model Profile {
  id           String     @id @default(uuid()) @db.Uuid
  role         Role
  name         String
  email        String?    @unique
  phone        String?
  passwordHash String?    @map("password_hash") // SHA-256 hex
  createdAt    DateTime   @default(now()) @map("created_at") @db.Timestamptz()

  // Relations
  agency     Agency?
  driver     Driver?
  packagesAsVendeur Package[] @relation("vendeur_packages")
  notifications     Notification[]

  @@map("profiles")
}

// 2. Table Agencies (Spécifique aux Agences)
model Agency {
  id            String       @id @db.Uuid
  address       String?
  phone         String?
  rating        Float?       @default(4.9)
  status        AgencyStatus @default(PENDING)
  coverageZones String[]     @default([]) @map("coverage_zones")
  fleetSize     Int          @default(1) @map("fleet_size")
  createdAt     DateTime     @default(now()) @map("created_at") @db.Timestamptz()

  // Relations
  profile    Profile    @relation(fields: [id], references: [id], onDelete: Cascade)
  drivers    Driver[]
  packages   Package[]

  @@map("agencies")
}

// 3. Table Drivers (Lien entre livreur et agence)
model Driver {
  id         String     @id @db.Uuid
  agencyId   String?    @map("agency_id") @db.Uuid
  phone      String?
  available  Boolean?   @default(true)
  vehicle    String?    @default("Moto")
  pinCode    String?    @map("pin_code") // SHA-256 hash du code PIN
  createdAt  DateTime   @default(now()) @map("created_at") @db.Timestamptz()

  // Relations
  profile    Profile    @relation(fields: [id], references: [id], onDelete: Cascade)
  agency     Agency?    @relation(fields: [agencyId], references: [id], onDelete: Cascade)
  packages   Package[]

  @@map("drivers")
}

// 4. Table Points de Dépôt / Relais (Drop-off & Pick-up)
model DropPoint {
  id           String    @id
  name         String
  commune      String
  address      String
  phone        String
  managerName  String    @map("manager_name")
  openingHours String    @map("opening_hours")
  isActive     Boolean   @default(true) @map("is_active")
  createdAt    DateTime  @default(now()) @map("created_at") @db.Timestamptz()

  // Relations
  originPackages Package[] @relation("origin_drop_point")
  destPackages   Package[] @relation("dest_drop_point")
  agents         DropPointAgent[]

  @@map("drop_points")
}

// 5. Table Packages (Colis)
model Package {
  id                  String        @id @default(uuid()) @db.Uuid
  trackingCode        String        @unique @map("tracking_code")
  vendeurId           String        @map("vendeur_id") @db.Uuid
  agencyId            String?       @map("agency_id") @db.Uuid
  driverId            String?       @map("driver_id") @db.Uuid

  clientName          String        @map("client_name")
  clientAddress       String        @map("client_address")
  clientPhone         String?       @map("client_phone")

  packagePrice        Float         @default(0) @map("package_price")
  deliveryPrice       Float?        @map("delivery_price")
  poids               Float         @default(1.0)
  longueur            Float?
  largeur             Float?
  hauteur             Float?
  distance            Float?

  // Paiement
  paidByClient        Boolean       @default(true)  @map("paid_by_client")
  isPrepaid           Boolean       @default(false) @map("is_prepaid")
  vendorPaid          Boolean       @default(false) @map("vendor_paid")

  status              PackageStatus @default(CREATED)
  validationCode      String        @map("validation_code")
  otpConfirmed        Boolean       @default(false) @map("otp_confirmed")
  pickupCode          String?       @map("pickup_code") // Code retrait point relais

  // Vendeur info (snapshot pour affichage livreur)
  vendeurName         String?       @map("vendeur_name")
  vendeurPhone        String?       @map("vendeur_phone")

  // Relais & Inaccessibilité
  deliveryMode        String        @default("DIRECT") @map("delivery_mode")
  originDropPointId   String?       @map("origin_drop_point_id")
  destDropPointId     String?       @map("dest_drop_point_id")
  inaccessibilityNote String?       @map("inaccessibility_note")
  reroutedAt          DateTime?     @map("rerouted_at") @db.Timestamptz()

  createdAt           DateTime      @default(now()) @map("created_at") @db.Timestamptz()
  updatedAt           DateTime      @default(now()) @updatedAt @map("updated_at") @db.Timestamptz()
  deliveredAt         DateTime?     @map("delivered_at") @db.Timestamptz()

  // Relations
  vendeur             Profile       @relation("vendeur_packages", fields: [vendeurId], references: [id], onDelete: Cascade)
  agency              Agency?       @relation(fields: [agencyId], references: [id], onDelete: SetNull)
  driver              Driver?       @relation(fields: [driverId], references: [id], onDelete: SetNull)
  originDropPoint     DropPoint?    @relation("origin_drop_point", fields: [originDropPointId], references: [id], onDelete: SetNull)
  destDropPoint       DropPoint?    @relation("dest_drop_point", fields: [destDropPointId], references: [id], onDelete: SetNull)

  @@map("packages")
}

// 6. Table DropPointAgent (Agents des Points Relais)
model DropPointAgent {
  id           String    @id @default(uuid()) @db.Uuid
  agentNumber  String    @unique @map("agent_number") @db.Char(9)
  pinHash      String    @map("pin_hash")
  name         String
  dropPointId  String    @map("drop_point_id")
  isActive     Boolean   @default(true) @map("is_active")
  createdAt    DateTime  @default(now()) @map("created_at") @db.Timestamptz()

  // Relations
  dropPoint    DropPoint @relation(fields: [dropPointId], references: [id], onDelete: Cascade)

  @@map("drop_point_agents")
}

// 7. Table Notifications
model Notification {
  id        String   @id @default(uuid()) @db.Uuid
  userId    String   @map("user_id") @db.Uuid // Points to Profile id
  message   String
  type      String   // e.g., "INFO", "SUCCESS", "WARNING"
  read      Boolean  @default(false)
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz()

  user      Profile  @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("notifications")
}
